generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  TECH
}

enum TimeLogStatus {
  OPEN
  CLOSED
}

enum LeadStatus {
  NEW
  PUSHED
  CLOSED
}

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  FAILED
}

enum SMSKind {
  REVIEW
  MARKETING
}

enum SMSStatus {
  PENDING
  AWAITING_APPROVAL
  DENIED
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timeLogs         TimeLog[]
  upsellLogs       UpsellLog[]
  leads            Lead[]                 @relation("LeadCreator")
  salesQuotes      SalesQuote[]           @relation("QuoteCreator")
  commissionRates  SalesCommissionRate[]
  campaigns        SMSCampaign[]
}

model TimeLog {
  id           String        @id @default(cuid())
  userId       String
  punchedInAt  DateTime      @default(now())
  punchedOutAt DateTime?
  status       TimeLogStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklist  ChecklistItem[]

  @@index([userId, status])
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ChecklistItem {
  id         String    @id @default(cuid())
  timeLogId  String
  label      String
  checked    Boolean   @default(false)
  checkedAt  DateTime?
  sortOrder  Int       @default(0)

  timeLog TimeLog @relation(fields: [timeLogId], references: [id], onDelete: Cascade)

  @@index([timeLogId])
}

model UpsellRule {
  id          String   @id @default(cuid())
  title       String
  description String
  tip         String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  logs UpsellLog[]
}

model UpsellLog {
  id          String   @id @default(cuid())
  techId      String
  ruleId      String?
  description String
  amount      Float?
  jobberJobId String?
  createdAt   DateTime @default(now())

  tech User        @relation(fields: [techId], references: [id], onDelete: Cascade)
  rule UpsellRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([techId])
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  source      String?
  status      LeadStatus @default(NEW)
  pushToJobber Boolean   @default(false)
  jobberId    String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User         @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  quotes    SalesQuote[]

  @@index([status])
  @@index([createdAt])
}

/** Per-salesman commission % by service line */
model SalesCommissionRate {
  id         String   @id @default(cuid())
  userId     String
  /** WINDOW | GUTTER | SPIDER | SERVICE_PLAN */
  serviceKey String
  percent    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceKey])
  @@index([userId])
}

model SalesQuote {
  id                 String   @id @default(cuid())
  leadId             String?
  createdById        String
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  /** Window calculator inputs */
  panes              Int      @default(0)
  floors             Int      @default(3)
  panesAbove         Int      @default(0)
  method             Float    @default(1)
  sides              Float    @default(1)
  discountType       String   @default("none")
  discountAmount     Float    @default(0)
  isCustomEstimate   Boolean  @default(false)
  windowAmount       Float    @default(0)
  gutterAmount       Float    @default(0)
  spiderAmount       Float    @default(0)
  servicePlanAmount  Float    @default(0)
  totalAmount        Float    @default(0)
  /** Full breakdown JSON for admin display */
  calculatorJson     String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead      Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User  @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
  @@index([leadId])
}

model JobberClient {
  id            String    @id @default(cuid())
  jobberId      String    @unique
  name          String
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  tags          String    @default("[]")
  isCommercial  Boolean   @default(false)
  isArchived    Boolean   @default(false)
  /** When true, JOB_COMPLETE does not send the Google review SMS */
  skipReviewSms Boolean   @default(false)
  lastServiceAt DateTime?
  jobberWebUri  String?
  rawJson       String?
  syncedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs JobberJob[]

  @@index([isCommercial])
  @@index([lastServiceAt])
  @@index([name])
}

model JobberJob {
  id            String    @id @default(cuid())
  jobberId      String    @unique
  clientId      String?
  title         String?
  status        String?
  completedAt   DateTime?
  scheduledAt   DateTime?
  jobberWebUri  String?
  rawJson       String?
  syncedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client JobberClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([completedAt])
}

model SMSTemplate {
  id        String   @id @default(cuid())
  name      String
  kind      SMSKind
  body      String
  /** JSON: [{ "key": "booking", "label": "Book", "url": "https://..." }] */
  linksJson String   @default("[]")
  /** Image URL inserted as text (Quo API has no MMS) */
  imageUrl  String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SMSMessage[]

  @@index([kind, isActive])
}

model SMSCampaign {
  id           String         @id @default(cuid())
  name         String
  filterJson   String         @default("{}")
  messageBody  String
  templateId   String?
  status       CampaignStatus @default(DRAFT)
  createdById  String
  totalCount   Int            @default(0)
  sentCount    Int            @default(0)
  failedCount  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages  SMSMessage[]

  @@index([templateId])
}

model SMSMessage {
  id           String    @id @default(cuid())
  campaignId   String?
  templateId   String?
  clientId     String?
  jobberJobId  String?
  to           String
  content      String
  status       SMSStatus @default(PENDING)
  kind         SMSKind
  providerId   String?
  error        String?
  clientName   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign SMSCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template SMSTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([templateId])
  @@index([kind, status, createdAt])
  @@index([kind, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  topic       String
  itemId      String
  accountId   String?
  payload     String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([topic, itemId])
  @@index([createdAt])
}

model JobberConnection {
  id           String   @id @default("default")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  accountId    String?
  accountName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

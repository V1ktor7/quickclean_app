# Neon / Postgres (required on Vercel — SQLite does not work on serverless)
# Create free DB: https://neon.tech or Vercel Marketplace → Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Production: https://your-app.vercel.app
AUTH_URL="http://localhost:3000"

# Seeded admin (run: npm run db:seed)
ADMIN_EMAIL="admin@quickclean.local"
ADMIN_PASSWORD="changeme123"

# Jobber OAuth app (Developer Center)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Must match Jobber OAuth Callback URL (use your Vercel domain in production)
JOBBER_REDIRECT_URI="http://localhost:3000/api/jobber/oauth/callback"
JOBBER_ACCESS_TOKEN=

# Quo (formerly OpenPhone) SMS
QUO_API_KEY=
QUO_FROM_NUMBER=

# Review automation
REVIEW_LINK_URL="https://g.page/r/your-review-link"
REVIEW_SMS_TEMPLATE="Thanks for choosing QuickClean! Leave a review: {{link}}"

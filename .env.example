# SQLite (local): file:./dev.db
# Neon Postgres (production): postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Seeded admin (prisma db seed)
ADMIN_EMAIL="admin@quickclean.local"
ADMIN_PASSWORD="changeme123"

# Jobber GraphQL (personal access / OAuth token)
JOBBER_ACCESS_TOKEN=
# Jobber OAuth client secret — used to verify X-Jobber-Hmac-SHA256
JOBBER_CLIENT_SECRET=

# Quo (formerly OpenPhone) SMS
QUO_API_KEY=
QUO_FROM_NUMBER=

# Review automation
REVIEW_LINK_URL="https://g.page/r/your-review-link"
REVIEW_SMS_TEMPLATE="Thanks for choosing QuickClean! Leave a review: {{link}}"
